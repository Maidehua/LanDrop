<Window x:Class="LanDrop.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LanDrop" Height="620" Width="860" MinHeight="520" MinWidth="720" Background="#F5F7FB">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="LanDrop" FontSize="30" FontWeight="Bold" Foreground="#172033"/><TextBlock x:Name="LocalInfo" Margin="0,6,0,22" Foreground="#61708A"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="ManualIp" Height="38" VerticalContentAlignment="Center" Padding="10,0" Text="" ToolTip="对方 IP，例如 192.168.1.8"/>
        <Button Grid.Column="1" Content="使用此 IP" Padding="20,8" Margin="12,0,0,0" Click="UseIp_Click" Background="#376CF6" Foreground="White" BorderThickness="0"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="12" Padding="16"><DockPanel><TextBlock DockPanel.Dock="Top" Text="附近设备" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="PeerList" DisplayMemberPath="Display" SelectionChanged="PeerList_SelectionChanged" BorderThickness="0"/></DockPanel></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="发送文件" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TargetText" Text="请先选择设备" Margin="0,12,0,18" Foreground="#61708A" TextWrapping="Wrap"/><Button Content="选择文件并发送" Height="44" Click="Send_Click" Background="#376CF6" Foreground="White" BorderThickness="0"/><ProgressBar x:Name="Progress" Height="8" Margin="0,18,0,0" Minimum="0" Maximum="100"/><TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="文件仅在当前局域网内点对点传输" HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="#8793A8"/>
  </Grid>
</Window>
